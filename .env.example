# Copy to .env (git-ignored). Never commit real values.
# mock = works offline, no key needed. live = calls watsonx.ai.
GRANITE_MODE=mock

# From watsonx.ai home page -> Developer access (Dallas region, hackathon sandbox project)
WATSONX_URL=
WATSONX_PROJECT_ID=
WATSONX_API_KEY=
# A Granite instruct model ID chosen in Prompt Lab (View code panel shows the exact ID).
# Do NOT use llama-3-405b-instruct, mistral-medium-2505 or mistral-small-3-1-24b-instruct-2503.
WATSONX_MODEL_ID=
